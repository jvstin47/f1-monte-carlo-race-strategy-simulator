# Backend Environment Configuration
# Copy this file to .env for local overrides

# Server binding
HOST=0.0.0.0
PORT=8005
DEBUG=false

# CORS (comma-separated allowed origins; use * for development, specific domain for production)
ALLOWED_ORIGINS=*

# FastF1 Telemetry Cache Directory
FASTF1_CACHE_DIR=/tmp/fastf1_cache
