# ========================================================
# Apex Strategy Simulator — Unified Environment Template
# ========================================================

# --------------------------------------------------------
# Backend Configuration (FastAPI / Render)
# --------------------------------------------------------
HOST=0.0.0.0
PORT=8005
DEBUG=false

# Allowed CORS Origins (comma-separated, e.g. https://your-app.vercel.app or * for dev)
ALLOWED_ORIGINS=*

# FastF1 Cache Directory (defaults to /tmp/fastf1_cache on ephemeral cloud hosts)
FASTF1_CACHE_DIR=/tmp/fastf1_cache

# --------------------------------------------------------
# Frontend Configuration (Vite / Vercel)
# --------------------------------------------------------
# Deployed Backend API URL (leave empty for local dev with Vite proxy)
VITE_API_BASE_URL=
